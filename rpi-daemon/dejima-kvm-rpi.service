[Unit]
Description=Dejima KVM HID Daemon (RPi)
After=graphical.target

[Service]
Type=simple
# Hints for display detection (auto-detected at runtime, these are fallback defaults)
# Wayland (Raspberry Pi OS Bookworm+)
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/1000
# X11 fallback (older Raspberry Pi OS)
Environment=DISPLAY=:0
ExecStart=/usr/local/bin/dejima-kvm-daemon-rpi -device /dev/ttyAMA0 -baud 115200
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=graphical.target
